{
  "name": "rollup-plugin-typescript2",
  "version": "0.37.1",
  "description": "Seamless integration between Rollup and TypeScript. Now with errors.",
  "main": "dist/rollup-plugin-typescript2.cjs.js",
  "module": "dist/rollup-plugin-typescript2.es.js",
  "jsnext:main": "dist/rollup-plugin-typescript2.es.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "keywords": [
    "rollup-plugin-typescript2",
    "rollup-plugin-typescript",
    "rollup-plugin",
    "typescript",
    "es2015",
    "rollup",
    "npm"
  ],
  "license": "MIT",
  "homepage": "https://github.com/ezolenko/rollup-plugin-typescript2",
  "author": "@ezolenko",
  "scripts": {
    "prebuild": "rimraf dist/*",
    "build": "rimraf dist/* && rollup -c --bundleConfigAsCjs",
    "watch": "rollup -c rollup.config.self.js --bundleConfigAsCjs -w ",
    "build-self": "rimraf dist/* && rollup -c rollup.config.self.js --bundleConfigAsCjs",
    "lint": "eslint .",
    "test": "jest",
    "test:ts7": "npm install --no-save typescript@7.0.2 && jest --runInBand __tests__/integration/no-errors.spec.ts -t \"integration - no errors$\"",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@rollup/pluginutils": "^5.3.0",
    "find-cache-dir": "^3.3.2",
    "fs-extra": "^10.0.0",
    "semver": "^7.5.4",
    "tslib": "^2.8.1",
    "typescript-compat": "npm:typescript@^6.0.3"
  },
  "peerDependencies": {
    "rollup": ">=1.26.3",
    "typescript": ">=2.4.0 <8"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@swc/core": "^1.14.1",
    "@swc/jest": "^0.2.39",
    "@types/find-cache-dir": "^2.0.0",
    "@types/fs-extra": "8.0.1",
    "@types/graphlib": "2.1.7",
    "@types/jest": "^29.5.14",
    "@types/lodash": "4.17.25",
    "@types/node": "^26.4.0",
    "@types/object-hash": "1.3.3",
    "@types/semver": "7.3.12",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "colors": "1.4.0",
    "eslint": "^8.57.1",
    "graphlib": "2.1.8",
    "jest": "^29.7.0",
    "lodash": "4.17.21",
    "object-hash": "3.0.0",
    "rimraf": "3.0.2",
    "rollup": "^4.63.1",
    "rollup-plugin-re": "1.0.7",
    "rollup-plugin-typescript2": "0.37.0",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ezolenko/rollup-plugin-typescript2.git"
  },
  "bugs": {
    "url": "https://github.com/ezolenko/rollup-plugin-typescript2/issues"
  }
}
